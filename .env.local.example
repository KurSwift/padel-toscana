# Copia este archivo a .env.local (ignorado por git) para desarrollar
# contra los emuladores de Firebase en vez de producción.
#
#   cp .env.local.example .env.local
#   npm run emulators   # en una terminal
#   npm run seed        # una vez, para prepoblar datos de prueba
#   npm run dev          # en otra terminal

VITE_USE_EMULATORS=true

# Opcional — para probar desde un celular en la misma red WiFi que tu
# computadora. Por default el cliente y `npm run emulators` (firebase.json →
# emulators.host) usan 127.0.0.1 (loopback) o 0.0.0.0, respectivamente; el
# celular no puede alcanzar el loopback de la computadora, así que hay que
# apuntar el cliente directo a su IP en la red local (ej. 192.168.1.6 — en
# macOS: `ipconfig getifaddr en0`). Luego levanta `npm run dev -- --host`
# (sin esto, Vite puede enlazar solo en IPv6 en algunas máquinas — ver
# AGENTS.md) y abre http://<esa-IP>:5173 desde el celular.
# VITE_EMULATOR_HOST=192.168.1.6

# Opcional — necesario para npm run test:e2e (Playwright), ya que las
# Cloud Functions con enforceAppCheck: true (ver AGENTS.md → App Check)
# también lo exigen contra el emulador de Functions, y cada test de
# Playwright arranca un contexto de navegador nuevo (un debug token
# generado con `= true` nunca alcanza a registrarse a tiempo). Pon aquí
# cualquier UUID fijo y regístralo una vez en Firebase Console → App Check
# → Manage debug tokens (o vía la API de firebaseappcheck.googleapis.com).
# VITE_APPCHECK_DEBUG_TOKEN=00000000-0000-0000-0000-000000000000
