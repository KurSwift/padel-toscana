{
  "name": "padel-toscana",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "emulators": "PATH=\"/opt/homebrew/opt/openjdk/bin:/usr/local/opt/openjdk/bin:$PATH\" firebase emulators:start --import=./.emulator-data --export-on-exit=./.emulator-data",
    "seed": "node scripts/seed.mjs",
    "push-to-prod": "node scripts/push-to-prod.mjs",
    "migrate-users-role": "node scripts/migrate-users-role.mjs",
    "preregister-colonos": "node scripts/preregister-colonos.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:functions": "npm --prefix functions run test",
    "functions:build": "npm --prefix functions run build",
    "functions:serve": "npm --prefix functions run serve",
    "functions:deploy": "npm --prefix functions run deploy"
  },
  "dependencies": {
    "firebase": "^11.7.1",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-hot-toast": "^2.5.2",
    "react-router-dom": "^7.6.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.6",
    "@types/node": "^25.6.0",
    "@types/react": "^19.1.3",
    "@types/react-dom": "^19.1.3",
    "@vitejs/plugin-react": "^4.4.1",
    "autoprefixer": "^10.4.21",
    "firebase-admin": "^14.3.0",
    "firebase-tools": "^15.28.2",
    "jsdom": "^30.0.1",
    "postcss": "^8.5.3",
    "tailwindcss": "^3.4.17",
    "typescript": "~5.8.3",
    "vite": "^6.3.4",
    "vitest": "^4.1.11"
  }
}
