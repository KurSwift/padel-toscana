rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isAuthenticated() {
      return request.auth != null;
    }

    function userRole() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role;
    }

    // super-admin es superset de admin (entra al panel normal también, ver
    // Epic #43) — isAdmin() lo incluye a propósito para que todas las
    // reglas que ya chequean isAdmin() (courts, addresses, reservations,
    // lectura/borrado de users) sigan funcionando sin tocarlas una por una.
    // La única capacidad EXCLUSIVA de super-admin (asignar roles) usa
    // isSuperAdmin() aparte, ver la regla users/{uid} abajo.
    function isAdmin() {
      return isAuthenticated() && userRole() in ['admin', 'super-admin'];
    }

    function isSuperAdmin() {
      return isAuthenticated() && userRole() == 'super-admin';
    }

    function isTesorero() {
      return isAuthenticated() && userRole() == 'tesorero';
    }

    function isColono() {
      return isAuthenticated() && userRole() == 'colono';
    }

    function isOwner(uid) {
      return request.auth.uid == uid;
    }

    // Compara los campos "de identidad" de una reservación entre el
    // documento existente y el propuesto — usado para asegurar que una
    // transición de status no cambie nada más (ver canTransition() y
    // effectiveStatus() en src/services/reservationRules.ts).
    function reservationCoreFieldsUnchanged() {
      return request.resource.data.userId        == resource.data.userId
          && request.resource.data.courtId       == resource.data.courtId
          && request.resource.data.date          == resource.data.date
          && request.resource.data.startTime     == resource.data.startTime
          && request.resource.data.endTime       == resource.data.endTime
          && request.resource.data.durationHours == resource.data.durationHours
          && request.resource.data.startAt       == resource.data.startAt
          && request.resource.data.endAt         == resource.data.endAt
          && request.resource.data.paymentDueAt  == resource.data.paymentDueAt
          && request.resource.data.playerCount   == resource.data.playerCount
          && request.resource.data.residentInChargeName == resource.data.residentInChargeName;
    }

    // ── Users ──────────────────────────────────────────────────────────────
    match /users/{uid} {
      allow read: if isOwner(uid) || isAdmin();

      // First-time registration: status must be 'pending', role must be 'colono'
      allow create: if isOwner(uid)
        && request.resource.data.role == 'colono'
        && request.resource.data.status == 'pending'
        && request.resource.data.keys().hasAll([
             'name', 'street', 'streetNumber', 'address',
             'addressNormalized', 'role', 'status', 'createdAt'
           ]);

      // User can update profile but cannot change role or status themselves.
      // Admin puede editar cualquier campo salvo `role` (asignar roles es
      // exclusivo de super-admin, ver isSuperAdmin() arriba y Epic #43).
      allow update: if (isOwner(uid)
          && request.resource.data.role == resource.data.role
          && request.resource.data.get('status', 'active') == resource.data.get('status', 'active'))
        || (isAdmin() && request.resource.data.role == resource.data.role)
        || isSuperAdmin();

      // Rechazar un registro pendiente (rejectUser() en src/services/users.ts)
      // sigue siendo cosa de cualquier admin — no cambia. Eliminar a
      // cualquier otro usuario (activo, con rol asignado) es exclusivo de
      // super-admin (adminDeleteColono, functions/src/index.ts) — sin esta
      // rama, un admin normal podría saltarse esa restricción llamando al
      // SDK del cliente directo en vez de pasar por la Cloud Function.
      allow delete: if (resource.data.status == 'pending' && isAdmin())
        || isSuperAdmin();
    }

    // ── Addresses ──────────────────────────────────────────────────────────
    match /addresses/{addressKey} {
      allow read: if true;

      allow create: if isAuthenticated()
        && request.resource.data.uids is list
        && request.resource.data.uids.size() == 1
        && request.resource.data.uids[0] == request.auth.uid;

      allow update: if (isAuthenticated()
          && resource.data.uids.size() < 2
          && request.resource.data.uids.hasAll(resource.data.uids)
          && request.resource.data.uids.size() == resource.data.uids.size() + 1
          && !resource.data.uids.hasAny([request.auth.uid]))
        || isAdmin();

      allow delete: if isAdmin();
    }

    // ── Settings ───────────────────────────────────────────────────────────
    // Doc único settings/theme ({ paletteId }, Epic #43 issue 5/5) — lectura
    // abierta, mismo criterio que addresses: ThemeProvider necesita aplicar
    // la paleta antes de que la persona se autentique (LoginPage incluida).
    // Escritura exclusiva de super-admin.
    match /settings/{docId} {
      allow read: if true;
      allow write: if isSuperAdmin();
    }

    // ── Rate limits ────────────────────────────────────────────────────────
    // Escrito/leído solo por createReservation (Admin SDK, bypasea estas
    // rules) — ver functions/src/rateLimit.ts. Bloqueado explícitamente para
    // que ningún cliente pueda leer su cupo restante ni resetear su propia
    // ventana escribiendo el doc directo.
    match /rateLimits/{uid} {
      allow read, write: if false;
    }

    // ── Mail ───────────────────────────────────────────────────────────────
    // Written by the app on new registration; read/processed by the extension.
    match /mail/{docId} {
      allow create: if isAuthenticated();
      allow read, update, delete: if false;
    }

    // ── Courts ─────────────────────────────────────────────────────────────
    match /courts/{courtId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    // ── Reservations ───────────────────────────────────────────────────────
    // Máquina de estados: solicitada → pagada → cancelada | finalizada.
    // Ver canTransition() en src/services/reservationRules.ts — si cambia
    // esta matriz, hay que actualizar esa función Y estas rules.
    match /reservations/{reservationId} {
      allow read: if isAuthenticated();

      // Crear una reservación requiere validar el límite de activas por
      // usuario y traslapes de horario — queries agregadas que rules no
      // puede hacer (solo get() de documentos puntuales). Por eso la única
      // vía para crear es la Cloud Function `createReservation`
      // (functions/src/index.ts): corre con Admin SDK (bypasea estas
      // rules) y hace esas dos validaciones + el write dentro de una
      // transacción de Firestore. Cualquier intento de creación directa
      // desde el cliente (incluso uno estructuralmente válido) se rechaza.
      allow create: if false;

      // Matriz de transición:
      //   solicitada → cancelada : dueño o admin, o CUALQUIER autenticado
      //                            si ya pasó paymentDueAt (auto-release
      //                            por falta de pago — issue 4/7)
      //   pagada     → cancelada : dueño o admin
      //   solicitada → pagada    : tesorero o admin
      //   solicitada|pagada → finalizada : admin, o CUALQUIER autenticado
      //                            si ya pasó endAt (issue 4/7)
      //   cualquier otra transición : solo admin
      // Las dos ramas "cualquier autenticado" son las que permiten la
      // escritura oportunista de effectiveStatus() en reservations.ts —
      // son seguras porque dependen de request.time (reloj del servidor),
      // no de nada que mande el cliente. Ninguna transición no-admin puede
      // tocar los demás campos.
      allow update: if (
          isOwner(resource.data.userId)
          && resource.data.status in ['solicitada', 'pagada']
          && request.resource.data.status == 'cancelada'
          && reservationCoreFieldsUnchanged()
        )
        || (
          isTesorero()
          && resource.data.status == 'solicitada'
          && request.resource.data.status == 'pagada'
          && reservationCoreFieldsUnchanged()
        )
        || (
          isAuthenticated()
          && resource.data.status == 'solicitada'
          && request.resource.data.status == 'cancelada'
          && request.time > resource.data.paymentDueAt
          && reservationCoreFieldsUnchanged()
        )
        || (
          isAuthenticated()
          && resource.data.status in ['solicitada', 'pagada']
          && request.resource.data.status == 'finalizada'
          && request.time > resource.data.endAt
          && reservationCoreFieldsUnchanged()
        )
        || isAdmin();

      allow delete: if false;
    }
  }
}
