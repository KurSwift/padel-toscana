rules_version = '2';

// Único uso hoy: logo del sitio (Epic #43, issue 4/5). Lectura pública
// porque LoginPage necesita mostrarlo antes de que la persona se
// autentique. Escritura exclusiva de super-admin — mismo rol que en
// firestore.rules (ver isSuperAdmin() ahí), pero leído del custom claim
// del token de Auth (request.auth.token.role), no de Firestore.
//
// Se probó primero con `firestore.get()` (Cross Service Rules) para leer
// users/{uid}.role directo, igual que firestore.rules — compilaba bien
// pero fallaba en runtime con "permission denied" en TODAS las subidas,
// aunque el rol fuera correcto. Diagnosticado en producción: Cross
// Service Rules requiere que Firestore y Storage estén en la MISMA
// ubicación, y este proyecto los tiene distintos (Firestore `nam5`,
// Storage `us-central1` — el bucket default que Firebase crea al activar
// Storage no necesariamente queda en la misma ubicación que Firestore).
// El custom claim se setea en adminSetUserRole (functions/src/index.ts)
// cada vez que cambia el rol de alguien — no depende de ubicaciones.
service firebase.storage {
  match /b/{bucket}/o {
    // Ruta fija, sin extensión en el path — el tipo real vive en el
    // metadata contentType del objeto (ver uploadLogo() en
    // src/services/branding.ts). Así "subir un logo nuevo" siempre
    // sobreescribe el mismo objeto sin dejar archivos huérfanos de un
    // formato anterior colgando en el bucket, y el resto de la app no
    // necesita guardar ninguna URL en Firestore — siempre es este mismo
    // path.
    match /branding/logo {
      allow read: if true;

      allow write: if request.auth != null
        && request.auth.token.role == 'super-admin'
        // Espejo de ALLOWED_LOGO_TYPES/MAX_LOGO_SIZE_BYTES en
        // src/services/brandingRules.ts — si cambia una, hay que
        // actualizar la otra (ver AGENTS.md).
        && request.resource.contentType in ['image/png', 'image/jpeg', 'image/svg+xml']
        && request.resource.size <= 5 * 1024 * 1024;
    }
  }
}
